<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Budget Buddy - Transactions</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/innserview/all.css">
</head>
<body class="page-placeholder">

    <%- include('innserview/nav') %>

    <%
        var incomeTypes = ['Salary', 'Freelance', 'Business', 'Other Income'];

        // Add up total income and total spending, and count entries
        var totalIncome   = 0;
        var totalSpending = 0;
        var incomeCount   = 0;
        var spendingCount = 0;
        for (var i = 0; i < transactions.length; i++) {
            var t = transactions[i];
            var amount = parseFloat(t.amount) || 0;
            if (t.type === 'income') {
                totalIncome = totalIncome + amount;
                incomeCount = incomeCount + 1;
            } else {
                totalSpending = totalSpending + amount;
                spendingCount = spendingCount + 1;
            }
        }
        var netBalance = totalIncome - totalSpending;
        var isSaving   = netBalance >= 0;

    %>

    <div class="dash-wrapper">
        <div class="container py-4">

            <div class="mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <h4 class="text-white fw-bold mb-0">
                        <i class="bi bi-bar-chart-line-fill text-info me-2"></i>Transactions Overview
                    </h4>
                    <p class="text-white-50 small mb-0">
                        <%= selectedMonth ? 'Showing: ' + new Date(selectedMonth + '-01').toLocaleString('en-SG', { month: 'long', year: 'numeric' }) : 'All-time summary of your income and expenses.' %>
                    </p>
                </div>
                <form method="GET" action="/history" class="d-flex gap-2 align-items-center">
                    <input type="month" name="month" class="form-control form-control-sm"
                           value="<%= selectedMonth %>"
                           style="background:#1e293b; color:#fff; border:1px solid rgba(255,255,255,0.2); width:160px;">
                    <button type="submit" class="btn btn-sm btn-info rounded-pill fw-bold px-3">Filter</button>
                    <% if (selectedMonth) { %>
                        <a href="/history" class="btn btn-sm btn-outline-light rounded-pill px-3">Clear</a>
                    <% } %>
                </form>
            </div>

            <% if (transactions.length === 0) { %>
            <div class="dash-card text-center py-5">
                <i class="bi bi-inbox text-white-50" style="font-size: 3rem;"></i>
                <p class="text-white-50 mt-3 mb-0">No transactions recorded yet.</p>
            </div>
            <% } else { %>

            <!-- Summary Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="stat-card stat-green">
                        <div class="stat-icon"><i class="bi bi-arrow-down-circle-fill"></i></div>
                        <div class="stat-label">Total Income</div>
                        <div class="stat-value">$<%= totalIncome.toFixed(2) %></div>
                        <div class="stat-sub"><%= incomeCount %> entries</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card stat-red">
                        <div class="stat-icon"><i class="bi bi-arrow-up-circle-fill"></i></div>
                        <div class="stat-label">Total Expenses</div>
                        <div class="stat-value">$<%= totalSpending.toFixed(2) %></div>
                        <div class="stat-sub"><%= spendingCount %> entries</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card <%= isSaving ? 'stat-blue' : 'stat-red' %>">
                        <div class="stat-icon">
                            <i class="bi <%= isSaving ? 'bi-piggy-bank-fill' : 'bi-exclamation-triangle-fill' %>"></i>
                        </div>
                        <div class="stat-label">Net Balance</div>
                        <div class="stat-value"><%= isSaving ? '+' : '-' %>$<%= Math.abs(netBalance).toFixed(2) %></div>
                        <div class="stat-sub">
                            <% if (isSaving) { %>
                                <i class="bi bi-check-circle-fill text-warning me-1"></i>You are saving money!
                            <% } else { %>
                                <i class="bi bi-x-circle-fill me-1"></i>Spending more than you earn
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

  

            <!-- Full Transaction List -->
            <div class="dash-card">
                <h6 class="text-white fw-bold mb-3">
                    <i class="bi bi-list-ul text-info me-2"></i>All Transactions
                </h6>
                <div class="table-responsive">
                    <table class="table table-borderless table-sm text-white mb-0" style="--bs-table-bg: transparent;">
                        <thead class="text-white-50" style="border-bottom: 1px solid rgba(255,255,255,0.15);">
                            <tr>
                                <th>#</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Date</th>
                                <th class="text-end">Amount</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% transactions.forEach((t, i) => {
                                const isIncome = t.type === 'income';
                            %>
                            <tr>
                                <td class="text-white-50"><%= i + 1 %></td>
                                <td>
                                    <span class="badge <%= isIncome ? 'bg-success' : 'bg-danger' %>">
                                        <%= t.category %>
                                    </span>
                                </td>
                                <td class="text-white-50"><%= t.description || '—' %></td>
                                <td class="text-white-50"><%= new Date(t.date).toLocaleDateString('en-SG') %></td>
                                <td class="text-end fw-bold <%= isIncome ? 'text-success' : 'text-danger' %>">
                                    <%= isIncome ? '+' : '-' %>$<%= parseFloat(t.amount).toFixed(2) %>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <button class="btn btn-sm btn-outline-info rounded-pill view-btn"
                                            data-category="<%= t.category %>"
                                            data-description="<%= t.description || '' %>"
                                            data-amount="<%= t.amount %>"
                                            data-date="<%= new Date(t.date).toLocaleDateString('en-SG') %>"
                                            data-bs-toggle="modal"
                                            data-bs-target="#viewModal">
                                            <i class="bi bi-eye-fill me-1"></i>View
                                        </button>
                                        <button class="btn btn-sm btn-outline-warning rounded-pill edit-btn"
                                            data-index="<%= t.originalIndex %>"
                                            data-category="<%= t.category %>"
                                            data-description="<%= t.description || '' %>"
                                            data-amount="<%= t.amount %>"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editModal">
                                            <i class="bi bi-pencil-fill me-1"></i>Edit
                                        </button>
                                        <form method="POST" action="/delete/<%= t.originalIndex %>" onsubmit="return confirm('Delete this transaction?')">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                                <i class="bi bi-trash-fill me-1"></i>Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>

            <% } %>
        </div>
    </div>

    <!-- View Transaction Modal -->
    <div class="modal fade" id="viewModal" tabindex="-1" aria-labelledby="viewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background:#1e293b; border:1px solid rgba(255,255,255,0.15);">
                <div class="modal-header" style="border-bottom:1px solid rgba(255,255,255,0.15);">
                    <h5 class="modal-title text-white fw-bold" id="viewModalLabel">
                        <i class="bi bi-eye-fill text-info me-2"></i>View Transaction
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Category</label>
                        <input type="text" id="viewCategory" class="form-control bg-dark text-white border-secondary" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Description</label>
                        <input type="text" id="viewDescription" class="form-control bg-dark text-white border-secondary" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Amount ($)</label>
                        <input type="text" id="viewAmount" class="form-control bg-dark text-white border-secondary" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Date</label>
                        <input type="text" id="viewDate" class="form-control bg-dark text-white border-secondary" readonly>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid rgba(255,255,255,0.15);">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Transaction Modal -->
    <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background:#1e293b; border:1px solid rgba(255,255,255,0.15);">
                <div class="modal-header" style="border-bottom:1px solid rgba(255,255,255,0.15);">
                    <h5 class="modal-title text-white fw-bold" id="editModalLabel">
                        <i class="bi bi-pencil-fill text-warning me-2"></i>Edit Transaction
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="editForm" method="POST" action="">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-white-50 small">Category</label>
                            <input type="text" name="category" id="editCategory" class="form-control bg-dark text-white border-secondary" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white-50 small">Description</label>
                            <input type="text" name="description" id="editDescription" class="form-control bg-dark text-white border-secondary" placeholder="Optional">
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white-50 small">Amount ($)</label>
                            <input type="number" name="amount" id="editAmount" class="form-control bg-dark text-white border-secondary" step="0.01" min="0" required>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top:1px solid rgba(255,255,255,0.15);">
                        <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning rounded-pill fw-bold">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('.view-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('viewCategory').value    = btn.dataset.category;
                document.getElementById('viewDescription').value = btn.dataset.description;
                document.getElementById('viewAmount').value      = btn.dataset.amount;
                document.getElementById('viewDate').value        = btn.dataset.date;
            });
        });

        document.querySelectorAll('.edit-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const idx = btn.dataset.index;
                document.getElementById('editForm').action = '/edit/' + idx;
                document.getElementById('editCategory').value   = btn.dataset.category;
                document.getElementById('editDescription').value = btn.dataset.description;
                document.getElementById('editAmount').value     = btn.dataset.amount;
            });
        });
    </script>
</body>
</html>
