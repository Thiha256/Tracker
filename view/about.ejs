<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Budget Buddy - About</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/innserview/all.css">
</head>
<body class="page-home">

    <%- include('innserview/nav') %>

    <div class="dash-wrapper">
        <div class="container py-4">

            <!-- Hero -->
            <div class="about-hero">
                <div class="hero-icon mb-3"><i class="bi bi-piggy-bank-fill"></i></div>
                <h1>About <span>Budget Buddy</span></h1>
                <p class="mt-3">Your personal finance companion — simple, smart, and built to help you take control of your money one transaction at a time.</p>
            </div>

            <hr class="divider">

            <!-- What We Do -->
            <div class="mb-5">
                <h5 class="text-white fw-bold text-center mb-4">
                    <i class="bi bi-stars text-warning me-2"></i>What Budget Buddy Does
                </h5>
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="f-icon text-success"><i class="bi bi-arrow-down-circle-fill"></i></div>
                            <h5>Track Income</h5>
                            <p>Log every source of income — salary, freelance, business — and always know what's coming in.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="f-icon text-danger"><i class="bi bi-cart-fill"></i></div>
                            <h5>Monitor Expenses</h5>
                            <p>Categorise your spending across food, transport, utilities and more to spot where your money goes.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="f-icon text-warning"><i class="bi bi-bar-chart-fill"></i></div>
                            <h5>Set Savings Goals</h5>
                            <p>Define a monthly savings target and watch your progress in real time with a visual tracker.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mission -->
            <div class="mission-card mb-5">
                <div class="row align-items-center g-4">
                    <div class="col-md-6">
                        <span class="tag-pill mb-3 d-inline-block">Our Mission</span>
                        <h4 class="fw-bold text-white mb-3">Financial clarity for everyone</h4>
                        <p class="text-white-50" style="line-height:1.8;">
                            We believe managing money shouldn't require a finance degree.
                            Budget Buddy strips away the complexity so anyone — student, freelancer, or professional —
                            can understand their finances and make better decisions every day.
                        </p>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex flex-column gap-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="step-badge">1</div>
                                <div>
                                    <div class="text-white fw-semibold">Add your transactions</div>
                                    <div class="text-white-50 small">Income or expense — log it in seconds.</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <div class="step-badge">2</div>
                                <div>
                                    <div class="text-white fw-semibold">See your overview</div>
                                    <div class="text-white-50 small">Instant totals, categories, and net balance.</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <div class="step-badge">3</div>
                                <div>
                                    <div class="text-white fw-semibold">Hit your savings goal</div>
                                    <div class="text-white-50 small">Track progress and adjust your habits.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Creator -->
            <div class="mb-5">
                <h5 class="text-white fw-bold text-center mb-4">
                    <i class="bi bi-person-heart text-warning me-2"></i>Meet the Creator
                </h5>
                <div class="row justify-content-center">
                    <div class="col-md-5">
                        <div class="creator-card">
                            <img src="/images/logo.jpg" alt="Creator" class="creator-avatar mb-3">
                            <h5 class="fw-bold text-white mb-1">Thiha</h5>
                            <p class="text-warning small fw-semibold mb-2">Developer &amp; Designer</p>
                            <p class="text-white-50 small mb-3">
                                Built Budget Buddy as a personal project to make everyday budgeting simple, visual, and actually enjoyable.
                            </p>
                            <div class="d-flex gap-2 justify-content-center flex-wrap">
                                <span class="tag-pill">Node.js</span>
                                <span class="tag-pill">Express</span>
                                <span class="tag-pill">EJS</span>
                                <span class="tag-pill">Bootstrap</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CTA -->
            <div class="dash-card text-center py-4 mb-2">
                <h5 class="text-white fw-bold mb-2">Ready to take control of your finances?</h5>
                <p class="text-white-50 small mb-3">Start tracking today — it only takes a minute.</p>
                <a href="/home" class="btn btn-warning fw-bold rounded-pill px-4">
                    <i class="bi bi-house-fill me-2"></i>Go to Dashboard
                </a>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
