<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Budget Buddy - Add Expense</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/innserview/all.css">
</head>
<body class="page-placeholder">

    <%- include('innserview/nav') %>

    <div class="dash-wrapper">
        <div class="container py-4">

            <div class="mb-4">
                <h4 class="text-white fw-bold mb-0">
                    <i class="bi bi-credit-card-2-front-fill text-danger me-2"></i>Add Expense
                </h4>
                <p class="text-white-50 small mb-0">Record your spending by category.</p>
            </div>

            <!-- Add Expense Form -->
            <div class="calc-card mb-4">
                <form action="/spending" method="POST">

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label>Category</label>
                            <select class="form-control" name="category" required>
                                <% spendingCategories.forEach(cat => { %>
                                <option value="<%= cat %>"><%= cat %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>Amount ($)</label>
                            <input type="number" class="form-control" name="amount"
                                   placeholder="e.g. 45" min="0" step="0.01" required>
                        </div>
                        <div class="col-md-4">
                            <label>Description (optional)</label>
                            <input type="text" class="form-control" name="description"
                                   placeholder="e.g. Lunch at canteen">
                        </div>
                        <div class="col-md-4">
                            <label>Date</label>
                            <input type="date" class="form-control" name="date"
                                   value="<%= new Date().toISOString().split('T')[0] %>" required>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-danger fw-bold rounded-pill px-5 py-2">
                            <i class="bi bi-plus-circle-fill me-2"></i>Add Expense
                        </button>
                        <a href="/home" class="btn btn-outline-light rounded-pill px-4 py-2 ms-2">Cancel</a>
                    </div>

                </form>
            </div>

            <!-- Add Custom Spending Category -->
            <div class="calc-card mb-4">
                <div class="section-title"><i class="bi bi-tag-fill me-2"></i>Add Custom Spending Category</div>
                <form action="/category/spending" method="POST" class="d-flex gap-2 align-items-end">
                    <div class="flex-grow-1">
                        <label>New Category Name</label>
                        <input type="text" class="form-control" name="category" placeholder="e.g. Subscriptions" required>
                    </div>
                    <button type="submit" class="btn btn-outline-danger rounded-pill px-4 py-2">
                        <i class="bi bi-plus-lg me-1"></i>Add
                    </button>
                </form>
            </div>

            <!-- This Month's Spending Entries -->
            <%
                var incomeTypes = ['Salary', 'Freelance', 'Business', 'Other Income'];
                var now = new Date();

                // Only keep spending transactions from this month
                var thisMonthSpending = [];
                for (var i = 0; i < transactions.length; i++) {
                    var t = transactions[i];
                    var transDate = new Date(t.date);
                    var sameMonth = transDate.getMonth() === now.getMonth();
                    var sameYear  = transDate.getFullYear() === now.getFullYear();
                    if (t.type === 'spending' && sameMonth && sameYear) {
                        thisMonthSpending.push(t);
                    }
                }
            %>

            <% if (thisMonthSpending.length > 0) { %>
            <div class="dash-card">
                <h6 class="text-white fw-bold mb-3">
                    <i class="bi bi-list-ul text-danger me-2"></i>This Month's Expenses
                </h6>
                <div class="table-responsive">
                    <table class="table table-borderless table-sm text-white mb-0" style="--bs-table-bg: transparent;">
                        <thead class="text-white-50" style="border-bottom: 1px solid rgba(255,255,255,0.15);">
                            <tr>
                                <th>#</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Date</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% thisMonthSpending.forEach((t, i) => { %>
                            <tr>
                                <td class="text-white-50"><%= i + 1 %></td>
                                <td><span class="badge bg-danger"><%= t.category %></span></td>
                                <td class="text-white-50"><%= t.description || '—' %></td>
                                <td class="text-white-50"><%= new Date(t.date).toLocaleDateString('en-SG') %></td>
                                <td class="text-end text-danger fw-bold">-$<%= parseFloat(t.amount).toFixed(2) %></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
            <% } %>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
